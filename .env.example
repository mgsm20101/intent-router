# Self-hosted LLM backend (OpenAI-compatible).
# Point at Ollama now; swap to a vLLM endpoint later with NO code change.
# NOTE: use 127.0.0.1 (not "localhost") on Windows — localhost can resolve to IPv6 ::1
# while Ollama binds 127.0.0.1, which looks like a hang.
OLLAMA_HOST=http://127.0.0.1:11434
# A smart, multilingual local model. 7b-instruct is a solid CPU-friendly default;
# qwen2.5:14b is stronger on Arabic if you have a GPU. Pull it first: `ollama pull <model>`.
LLM_MODEL=qwen2.5:7b-instruct
# Fail a stuck call instead of hanging forever (seconds).
LLM_TIMEOUT_S=120

# Cost model assumptions for the eval harness (USD per hour of the serving instance).
# Encoder runs on a small CPU box; the LLM needs a GPU. Tune to your real infra.
ENCODER_HOST_USD_PER_HOUR=0.05
LLM_HOST_USD_PER_HOUR=0.90

# The .NET gateway does NOT read this file. Its upstream URL is PYTHON_API_BASE in
# dotnet/IntentRouter.Api/appsettings.json (http://127.0.0.1:8000); override it with a
# real environment variable, e.g.  PYTHON_API_BASE=http://127.0.0.1:8000 dotnet run
